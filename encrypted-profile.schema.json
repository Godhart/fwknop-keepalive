{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPA Keepalive encrypted profile v2",
  "description": "AES-256-GCM envelope containing a profile.schema.json v1 object. Password: UTF-8, no normalization. AAD: fwknop-keepalive/profile/v2. ciphertext includes the 16-byte authentication tag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "format",
    "kdf",
    "iterations",
    "salt",
    "nonce",
    "ciphertext"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "format": {
      "type": "string",
      "const": "spa-profile-aes256-gcm"
    },
    "kdf": {
      "type": "string",
      "const": "pbkdf2-sha256"
    },
    "iterations": {
      "type": "integer",
      "const": 600000
    },
    "salt": {
      "type": "string",
      "description": "16 random bytes, canonical padded Base64",
      "pattern": "^[A-Za-z0-9+/]{22}==$"
    },
    "nonce": {
      "type": "string",
      "description": "12 random bytes, canonical Base64",
      "pattern": "^[A-Za-z0-9+/]{16}$"
    },
    "ciphertext": {
      "type": "string",
      "description": "Ciphertext followed by 128-bit GCM tag; canonical Base64; decoded length 17..8192",
      "minLength": 24,
      "maxLength": 10924,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
